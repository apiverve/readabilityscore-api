{
    "name": "apiverve/readabilityscore",
    "description": "Text Readability Score calculates the readability score and grade level of any text across standard formulas. It returns Flesch Reading Ease, Gunning Fog, Coleman-Liau, syllable and word counts, an average grade level, and a target audience label.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "readabilityscore",
        "readability score api",
        "text readability",
        "calculate readability score",
        "reading grade level",
        "flesch kincaid grade level"
    ],
    "homepage": "https://apiverve.com/marketplace/readabilityscore?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/readabilityscore",
        "source": "https://github.com/apiverve/readabilityscore-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Readabilityscore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Readabilityscore\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
